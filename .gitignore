# Internal build references (used to build Sentri with AI) stay out of version control.
# User-facing docs such as README.md are committed.
/docs/
/sentri-documentation.md.txt
/CLAUDE.md

# Environments and caches
.venv/
/venv/
/env/
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
/dist/
/build/
*.egg-info/

# Sentri runtime output
.sentri/
/evidence/
/contract.draft.yaml
/report.md

# Temporary contracts written by the integration tests
examples/buggy-app/.contract-*.yaml
/examples/buggy-app/approved.yaml
/examples/flow-shop/approved*.yaml
/examples/buggy-app/approved*.yaml

# Apps downloaded by examples/proof/fetch_apps.py (third-party code, not committed)
examples/proof/*/app/

# Local secrets (API keys); never committed
.env
.env.*

# AI design references (impeccable): internal, not committed
PRODUCT.md
DESIGN.md
DESIGN.json
.impeccable/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
